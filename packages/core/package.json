{
  "name": "@calypso/core",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration engine: task graph, workers, teams, bus, memory, scheduler, PermissionGate (Anky)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@calypso/shared": "*",
    "@calypso/models": "*",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0"
  }
}
