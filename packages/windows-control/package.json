{
  "name": "@calypso/windows-control",
  "version": "0.1.0",
  "private": true,
  "description": "Windows control: long-lived PowerShell host (stdin/stdout JSON), UIA, SendInput, processes, files, screenshots (Trice)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --test --test-timeout=30000 test/host.test.mjs"
  },
  "dependencies": {
    "@calypso/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  },
  "files": [
    "dist",
    "host"
  ]
}
