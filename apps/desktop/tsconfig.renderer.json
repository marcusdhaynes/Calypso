{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/renderer-types",
    "rootDir": "src/renderer",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/renderer/**/*"]
}
