{
  "name": "@calypso/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Calypso Electron shell (main + preload + React renderer)",
  "main": "unified.cjs",
  "type": "module",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && node scripts/rename-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:core && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev:renderer": "vite",
    "dev": "npm run build:main && npm run build:preload && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "pack:win": "electron-builder --win --x64",
    "clean": "rm -rf dist out release",
    "build:core": "tsc -p tsconfig.core.json",
    "test:integration": "node test/integration-smoke.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "pack:win:dir": "electron-builder --win --x64 --dir",
    "postinstall": "node -e \"process.exit(0)\"",
    "pack:win:nsis": "electron-builder --win nsis --x64",
    "pack:win:portable": "electron-builder --win portable --x64",
    "stage:win-native": "node scripts/stage-win-native.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^11.5.0"
  },
  "build": {
    "appId": "com.calypso.app",
    "productName": "Calypso",
    "directories": {
      "output": "release"
    },
    "files": [
      "unified.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Calypso",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Calypso-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calypso",
      "uninstallDisplayName": "Calypso"
    },
    "portable": {
      "artifactName": "Calypso-Portable-${version}.${ext}"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "extraMetadata": {
      "main": "unified.cjs"
    },
    "electronVersion": "33.4.11",
    "asar": {
      "smartUnpack": true
    },
    "extraResources": [
      {
        "from": "../bridge",
        "to": "calypso-bridge",
        "filter": [
          "server.mjs"
        ]
      },
      {
        "from": "../web",
        "to": "calypso-web",
        "filter": [
          "**/*",
          "!package.json"
        ]
      },
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "author": "Calypso"
}
